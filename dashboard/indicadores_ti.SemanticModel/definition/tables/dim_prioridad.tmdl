table dim_prioridad
	lineageTag: fb7ad46a-7a60-4dcb-a228-c128e206395c

	column prioridad
		dataType: string
		lineageTag: dffeee3d-a91a-4dc6-90ae-86268b070747
		summarizeBy: none
		sourceColumn: prioridad
		sortByColumn: orden

	column sla_horas
		dataType: int64
		lineageTag: c6040023-54c8-4cf1-897b-05a78d3b5959
		summarizeBy: none
		sourceColumn: sla_horas

	column orden
		dataType: int64
		isHidden
		lineageTag: c3d23df9-8c76-4143-9056-00dcaf9c4bc9
		summarizeBy: none
		sourceColumn: orden

	partition dim_prioridad = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaProyecto & "referencia\sla.csv"), [Delimiter = ",", Encoding = 65001]),
				    Cabecera = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecera, {{"prioridad", type text}, {"sla_horas", Int64.Type}}),
				    Orden = Table.AddColumn(Tipos, "orden", each
				        if [prioridad] = "Critica" then 1 else if [prioridad] = "Alta" then 2
				        else if [prioridad] = "Media" then 3 else 4, Int64.Type)
				in
				    Orden

