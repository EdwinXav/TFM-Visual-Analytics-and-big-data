{
  "name": "indicadores_ti",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-ES",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "sourceQueryCulture": "es-EC",
    "tables": [
      {
        "name": "fact_tickets",
        "columns": [
          {
            "name": "ticket_id",
            "dataType": "string",
            "sourceColumn": "ticket_id",
            "summarizeBy": "none"
          },
          {
            "name": "fecha_apertura",
            "dataType": "dateTime",
            "sourceColumn": "fecha_apertura",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy hh:nn:ss"
          },
          {
            "name": "fecha_cierre",
            "dataType": "dateTime",
            "sourceColumn": "fecha_cierre",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy hh:nn:ss"
          },
          {
            "name": "fecha_apertura_key",
            "dataType": "int64",
            "sourceColumn": "fecha_apertura_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha_cierre_key",
            "dataType": "int64",
            "sourceColumn": "fecha_cierre_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "equipo_id",
            "dataType": "string",
            "sourceColumn": "equipo_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "usuario_id",
            "dataType": "string",
            "sourceColumn": "usuario_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "categoria",
            "dataType": "string",
            "sourceColumn": "categoria",
            "summarizeBy": "none"
          },
          {
            "name": "prioridad",
            "dataType": "string",
            "sourceColumn": "prioridad",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "estado",
            "dataType": "string",
            "sourceColumn": "estado",
            "summarizeBy": "none"
          },
          {
            "name": "tecnico",
            "dataType": "string",
            "sourceColumn": "tecnico",
            "summarizeBy": "none"
          },
          {
            "name": "horas_resolucion",
            "dataType": "double",
            "sourceColumn": "horas_resolucion",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "sla_horas",
            "dataType": "double",
            "sourceColumn": "sla_horas",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "abierto",
            "dataType": "boolean",
            "sourceColumn": "abierto",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "cumple_sla",
            "dataType": "boolean",
            "sourceColumn": "cumple_sla",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "fact_tickets",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Parquet.Document(File.Contents(RutaProyecto & \"data\\analytics\\\" & Conjunto & \"\\fact_tickets.parquet\")),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"fecha_apertura\", type datetime}, {\"fecha_cierre\", type datetime}, {\"fecha_apertura_key\", Int64.Type}, {\"fecha_cierre_key\", Int64.Type}, {\"horas_resolucion\", type number}, {\"sla_horas\", type number}, {\"abierto\", type logical}, {\"cumple_sla\", type logical}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_equipo",
        "columns": [
          {
            "name": "equipo_id",
            "dataType": "string",
            "sourceColumn": "equipo_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "tipo",
            "dataType": "string",
            "sourceColumn": "tipo",
            "summarizeBy": "none"
          },
          {
            "name": "marca",
            "dataType": "string",
            "sourceColumn": "marca",
            "summarizeBy": "none"
          },
          {
            "name": "modelo",
            "dataType": "string",
            "sourceColumn": "modelo",
            "summarizeBy": "none"
          },
          {
            "name": "fecha_adquisicion",
            "dataType": "dateTime",
            "sourceColumn": "fecha_adquisicion",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy"
          },
          {
            "name": "fecha_fin_garantia",
            "dataType": "dateTime",
            "sourceColumn": "fecha_fin_garantia",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy"
          },
          {
            "name": "estado",
            "dataType": "string",
            "sourceColumn": "estado",
            "summarizeBy": "none"
          },
          {
            "name": "ubicacion",
            "dataType": "string",
            "sourceColumn": "ubicacion",
            "summarizeBy": "none"
          },
          {
            "name": "usuario_id",
            "dataType": "string",
            "sourceColumn": "usuario_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "antiguedad_anios",
            "dataType": "double",
            "sourceColumn": "antiguedad_anios",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "garantia_vencida",
            "dataType": "boolean",
            "sourceColumn": "garantia_vencida",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "activo",
            "dataType": "boolean",
            "sourceColumn": "activo",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "dim_equipo",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Parquet.Document(File.Contents(RutaProyecto & \"data\\analytics\\\" & Conjunto & \"\\dim_equipo.parquet\")),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"fecha_adquisicion\", type date}, {\"fecha_fin_garantia\", type date}, {\"antiguedad_anios\", type number}, {\"garantia_vencida\", type logical}, {\"activo\", type logical}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_usuario",
        "columns": [
          {
            "name": "usuario_id",
            "dataType": "string",
            "sourceColumn": "usuario_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "departamento",
            "dataType": "string",
            "sourceColumn": "departamento",
            "summarizeBy": "none"
          },
          {
            "name": "ubicacion",
            "dataType": "string",
            "sourceColumn": "ubicacion",
            "summarizeBy": "none"
          },
          {
            "name": "rol",
            "dataType": "string",
            "sourceColumn": "rol",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_usuario",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Parquet.Document(File.Contents(RutaProyecto & \"data\\analytics\\\" & Conjunto & \"\\dim_usuario.parquet\"))",
                "in",
                "    Origen"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_fecha",
        "columns": [
          {
            "name": "fecha_key",
            "dataType": "int64",
            "sourceColumn": "fecha_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none",
            "formatString": "dd/mm/yyyy",
            "isKey": true
          },
          {
            "name": "anio",
            "dataType": "int64",
            "sourceColumn": "anio",
            "summarizeBy": "none"
          },
          {
            "name": "trimestre",
            "dataType": "int64",
            "sourceColumn": "trimestre",
            "summarizeBy": "none"
          },
          {
            "name": "mes",
            "dataType": "int64",
            "sourceColumn": "mes",
            "summarizeBy": "none"
          },
          {
            "name": "semana",
            "dataType": "int64",
            "sourceColumn": "semana",
            "summarizeBy": "none"
          },
          {
            "name": "dia_semana",
            "dataType": "int64",
            "sourceColumn": "dia_semana",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Año-Mes",
            "dataType": "string",
            "summarizeBy": "none",
            "expression": "FORMAT ( dim_fecha[fecha], \"yyyy-MM\" )"
          },
          {
            "type": "calculated",
            "name": "Año-Trimestre",
            "dataType": "string",
            "summarizeBy": "none",
            "expression": "dim_fecha[anio] & \"-T\" & dim_fecha[trimestre]"
          }
        ],
        "partitions": [
          {
            "name": "dim_fecha",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Parquet.Document(File.Contents(RutaProyecto & \"data\\analytics\\\" & Conjunto & \"\\dim_fecha.parquet\")),",
                "    Tipos = Table.TransformColumnTypes(Origen, {{\"fecha_key\", Int64.Type}, {\"fecha\", type date}, {\"anio\", Int64.Type}, {\"trimestre\", Int64.Type}, {\"mes\", Int64.Type}, {\"semana\", Int64.Type}, {\"dia_semana\", Int64.Type}})",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
      {
        "name": "dim_prioridad",
        "columns": [
          {
            "name": "prioridad",
            "dataType": "string",
            "sourceColumn": "prioridad",
            "summarizeBy": "none",
            "sortByColumn": "orden"
          },
          {
            "name": "sla_horas",
            "dataType": "int64",
            "sourceColumn": "sla_horas",
            "summarizeBy": "none"
          },
          {
            "name": "orden",
            "dataType": "int64",
            "sourceColumn": "orden",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "dim_prioridad",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(RutaProyecto & \"referencia\\sla.csv\"), [Delimiter = \",\", Encoding = 65001]),",
                "    Cabecera = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecera, {{\"prioridad\", type text}, {\"sla_horas\", Int64.Type}}),",
                "    Orden = Table.AddColumn(Tipos, \"orden\", each",
                "        if [prioridad] = \"Critica\" then 1 else if [prioridad] = \"Alta\" then 2",
                "        else if [prioridad] = \"Media\" then 3 else 4, Int64.Type)",
                "in",
                "    Orden"
              ]
            }
          }
        ]
      },
      {
        "name": "calidad_resumen",
        "columns": [
          {
            "name": "tabla",
            "dataType": "string",
            "sourceColumn": "tabla",
            "summarizeBy": "none"
          },
          {
            "name": "regla",
            "dataType": "string",
            "sourceColumn": "regla",
            "summarizeBy": "none"
          },
          {
            "name": "registros",
            "dataType": "int64",
            "sourceColumn": "registros",
            "summarizeBy": "none"
          },
          {
            "name": "entrada",
            "dataType": "int64",
            "sourceColumn": "entrada",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "calidad_resumen",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Parquet.Document(File.Contents(RutaProyecto & \"data\\analytics\\\" & Conjunto & \"\\calidad_resumen.parquet\"))",
                "in",
                "    Origen"
              ]
            }
          }
        ]
      },
      {
        "name": "deteccion",
        "columns": [
          {
            "name": "familia",
            "dataType": "string",
            "sourceColumn": "familia",
            "summarizeBy": "none"
          },
          {
            "name": "regla",
            "dataType": "string",
            "sourceColumn": "regla",
            "summarizeBy": "none"
          },
          {
            "name": "inyectadas",
            "dataType": "int64",
            "sourceColumn": "inyectadas",
            "summarizeBy": "none"
          },
          {
            "name": "detectadas",
            "dataType": "int64",
            "sourceColumn": "detectadas",
            "summarizeBy": "none"
          },
          {
            "name": "aciertos",
            "dataType": "int64",
            "sourceColumn": "aciertos",
            "summarizeBy": "none"
          },
          {
            "name": "falsos_positivos",
            "dataType": "int64",
            "sourceColumn": "falsos_positivos",
            "summarizeBy": "none"
          },
          {
            "name": "tasa_deteccion",
            "dataType": "double",
            "sourceColumn": "tasa_deteccion",
            "summarizeBy": "none",
            "formatString": "0.0%"
          }
        ],
        "partitions": [
          {
            "name": "deteccion",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(File.Contents(RutaProyecto & \"resultados\\calidad\\\" & Conjunto & \"\\deteccion.csv\"), [Delimiter = \",\", Encoding = 65001]),",
                "    Cabecera = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),",
                "    Tipos = Table.TransformColumnTypes(Cabecera, {",
                "        {\"familia\", type text}, {\"regla\", type text},",
                "        {\"inyectadas\", Int64.Type}, {\"detectadas\", Int64.Type}, {\"aciertos\", Int64.Type},",
                "        {\"falsos_positivos\", Int64.Type}, {\"tasa_deteccion\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
      {
        "name": "kpi_resumen",
        "columns": [
          {
            "name": "kpi",
            "dataType": "string",
            "sourceColumn": "kpi",
            "summarizeBy": "none"
          },
          {
            "name": "indicador",
            "dataType": "string",
            "sourceColumn": "indicador",
            "summarizeBy": "none"
          },
          {
            "name": "dimension",
            "dataType": "string",
            "sourceColumn": "dimension",
            "summarizeBy": "none"
          },
          {
            "name": "categoria",
            "dataType": "string",
            "sourceColumn": "categoria",
            "summarizeBy": "none"
          },
          {
            "name": "valor",
            "dataType": "double",
            "sourceColumn": "valor",
            "summarizeBy": "none",
            "formatString": "0.0000"
          }
        ],
        "partitions": [
          {
            "name": "kpi_resumen",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Parquet.Document(File.Contents(RutaProyecto & \"data\\analytics\\\" & Conjunto & \"\\kpi_resumen.parquet\"))",
                "in",
                "    Origen"
              ]
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "auxiliar",
            "dataType": "string",
            "sourceColumn": "auxiliar",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = #table(type table [auxiliar = text], {})",
                "in",
                "    Origen"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Tickets abiertos",
            "expression": [
              "COUNTROWS ( fact_tickets )"
            ],
            "formatString": "#,0",
            "displayFolder": "Volumen"
          },
          {
            "name": "Tickets cerrados",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( fact_tickets ),",
              "    fact_tickets[abierto] = FALSE (),",
              "    USERELATIONSHIP ( dim_fecha[fecha_key], fact_tickets[fecha_cierre_key] )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Volumen"
          },
          {
            "name": "Fecha de corte",
            "expression": [
              "MAX ( dim_fecha[fecha] )"
            ],
            "formatString": "dd/mm/yyyy",
            "displayFolder": "Volumen"
          },
          {
            "name": "Backlog",
            "expression": [
              "VAR fin = [Fecha de corte] + 1",
              "RETURN",
              "    CALCULATE (",
              "        COUNTROWS ( fact_tickets ),",
              "        REMOVEFILTERS ( dim_fecha ),",
              "        fact_tickets[fecha_apertura] < fin,",
              "        OR ( ISBLANK ( fact_tickets[fecha_cierre] ), fact_tickets[fecha_cierre] >= fin )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Volumen"
          },
          {
            "name": "MTTR (h)",
            "expression": [
              "CALCULATE (",
              "    AVERAGE ( fact_tickets[horas_resolucion] ),",
              "    fact_tickets[abierto] = FALSE (),",
              "    USERELATIONSHIP ( dim_fecha[fecha_key], fact_tickets[fecha_cierre_key] )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Servicio"
          },
          {
            "name": "Cerrados en SLA",
            "expression": [
              "CALCULATE ( [Tickets cerrados], fact_tickets[cumple_sla] = TRUE () )"
            ],
            "formatString": "#,0",
            "displayFolder": "Servicio"
          },
          {
            "name": "% cumplimiento SLA",
            "expression": [
              "DIVIDE ( [Cerrados en SLA], [Tickets cerrados] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Servicio"
          },
          {
            "name": "Equipos",
            "expression": [
              "COUNTROWS ( dim_equipo )"
            ],
            "formatString": "#,0",
            "displayFolder": "Parque"
          },
          {
            "name": "Equipos activos",
            "expression": [
              "CALCULATE ( COUNTROWS ( dim_equipo ), dim_equipo[activo] = TRUE () )"
            ],
            "formatString": "#,0",
            "displayFolder": "Parque"
          },
          {
            "name": "Antigüedad media (años)",
            "expression": [
              "CALCULATE ( AVERAGE ( dim_equipo[antiguedad_anios] ), dim_equipo[activo] = TRUE () )"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Parque"
          },
          {
            "name": "Garantías vencidas",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( dim_equipo ),",
              "    dim_equipo[activo] = TRUE (),",
              "    dim_equipo[garantia_vencida] = TRUE ()",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Parque"
          },
          {
            "name": "% garantías vencidas",
            "expression": [
              "DIVIDE ( [Garantías vencidas], [Equipos activos] )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Parque"
          },
          {
            "name": "Tickets por equipo",
            "expression": [
              "DIVIDE ( [Tickets abiertos], [Equipos] )"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Relación"
          },
          {
            "name": "Registros de entrada",
            "expression": [
              "SUMX ( VALUES ( calidad_resumen[tabla] ), CALCULATE ( MAX ( calidad_resumen[entrada] ) ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Calidad"
          },
          {
            "name": "Incumplimientos",
            "expression": [
              "SUM ( calidad_resumen[registros] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Calidad"
          },
          {
            "name": "Registros válidos",
            "expression": [
              "SUMX (",
              "    VALUES ( calidad_resumen[tabla] ),",
              "    SWITCH (",
              "        calidad_resumen[tabla],",
              "        \"tickets\",    COUNTROWS ( fact_tickets ),",
              "        \"inventario\", COUNTROWS ( dim_equipo ),",
              "        \"usuarios\",   COUNTROWS ( dim_usuario )",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Calidad"
          },
          {
            "name": "Registros rechazados",
            "expression": [
              "[Registros de entrada] - [Registros válidos]"
            ],
            "formatString": "#,0",
            "displayFolder": "Calidad"
          },
          {
            "name": "% rechazados",
            "expression": [
              "DIVIDE ( [Registros rechazados], [Registros de entrada] )"
            ],
            "formatString": "0.00%",
            "displayFolder": "Calidad"
          },
          {
            "name": "Tasa de detección",
            "expression": [
              "CALCULATE ( MAX ( deteccion[tasa_deteccion] ), deteccion[familia] = \"total\" )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Calidad"
          },
          {
            "name": "Valor DAX",
            "expression": [
              "VAR k = SELECTEDVALUE ( kpi_resumen[kpi] )",
              "VAR d = SELECTEDVALUE ( kpi_resumen[dimension] )",
              "VAR c = SELECTEDVALUE ( kpi_resumen[categoria] )",
              "RETURN",
              "    SWITCH (",
              "        d,",
              "        \"total\",",
              "            SWITCH (",
              "                k,",
              "                \"K1\", [Tickets abiertos],",
              "                \"K2\", [Tickets cerrados],",
              "                \"K3\", [Backlog],",
              "                \"K4\", [MTTR (h)],",
              "                \"K5\", [% cumplimiento SLA] * 100,",
              "                \"K7\", [Antigüedad media (años)],",
              "                \"K8\", [Garantías vencidas]",
              "            ),",
              "        \"prioridad\",",
              "            CALCULATE (",
              "                SWITCH ( k, \"K4\", [MTTR (h)], \"K5\", [% cumplimiento SLA] * 100 ),",
              "                TREATAS ( { c }, dim_prioridad[prioridad] )",
              "            ),",
              "        \"estado\",       CALCULATE ( [Equipos], TREATAS ( { c }, dim_equipo[estado] ) ),",
              "        \"modelo\",       CALCULATE ( [Tickets por equipo], TREATAS ( { c }, dim_equipo[modelo] ) ),",
              "        \"departamento\", CALCULATE ( [Tickets abiertos], TREATAS ( { c }, dim_usuario[departamento] ) ),",
              "        \"ubicacion\",    CALCULATE ( [Tickets abiertos], TREATAS ( { c }, dim_usuario[ubicacion] ) )",
              "    )"
            ],
            "formatString": "0.0000",
            "displayFolder": "Verificación"
          },
